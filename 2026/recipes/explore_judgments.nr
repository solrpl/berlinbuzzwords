#%%vespa
#H1 Query top terms
POST /search/
{
  "select": {
    "where": true,
    "grouping": [
      {
        "all": {
          "group": "query_terms",
          "order": "-count()",
          "each": {
            "output": "count()",
          }
        }
      }
    ]
  },
  "model": {
    "restrict": "judgment"
  },
  "hits": 1
}
#%%vespa
#H1 Without "stopwords"
%AssignRequestResponse_toPythonDict:query_terms_facet
POST /search/
{
  "select": {
    "where": true,
    "grouping": [
      {
        "all": {
          "group": "query_terms",
          "order": "-count()",
          "max": 20,
          "filter": "not regex('the|what|is|in|and|for|of|to|which|as|this|a|with', query_terms)",
          "each": {
            "output": "count()",
          }
        }
      }
    ]
  },
  "model": {
    "restrict": "judgment"
  },
  "hits": 1
}
#%%python
import polars as pl

# Drill into the grouping result: root -> group:root -> grouplist:rating -> per-value groups
query_terms_groups = query_terms_facet['vespaResponse']['root']['children'][0]['children'][0]['children']
df = pl.DataFrame({
    "term": [g["value"] for g in query_terms_groups],
    "count": [g["fields"]["count()"] for g in query_terms_groups],
}).sort("count", descending=True)

#print(df)
# navigator_display_dataFrame(DataFrame=df)
navigator_display_chart(DataFrame=df, chartType='doughnutChart', labelField='term', valueField='count', sampling=True)
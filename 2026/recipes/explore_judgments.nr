#%%vespa
#H1 Top reasons
POST /search/
{
  "select": {
    "where": true,
    "grouping": [
      {
        "all": {
          "group": "explanation_attribute",
          "order": "-count()",
          "each": {
            "output": "count()",
            "label": "explanations"
          }
        }
      }
    ]
  },
  "model": {
    "restrict": "judgment"
  },
  "hits": 1
}
#%%vespa
#H1 Queries looking for a specific ID
POST /search/
{
  "select": {
    "where": {
      "contains": [
        "query",
        {
          "text": {
            "query": "id:movies:movie",
            "attributes": {
              "grammar": "phrase"
            }
          }
        }
      ]
    }
  },
  "model": {
    "restrict": "judgment"
  }
}
#%%vespa
#H1 Rating breakdown of ID queries?
%AssignRequestResponse_toPythonDict:id_query_ratings
POST /search/
{
  "select": {
    "where": {
      "contains": [
        "query",
        {
          "text": {
            "query": "id:movies:movie",
            "attributes": {
              "grammar": "phrase"
            }
          }
        }
      ]
    },
    "grouping": [
      {
        "all": {
          "group": "rating",
          "each": {
            "output": "count()",
          }
        }
      }
    ]
  },
  "model": {
    "restrict": "judgment"
  },
  "hits": 0
}
#%%python
#H1 Rating breakdown as a DataFrame
import polars as pl

# Drill into the grouping result: root -> group:root -> grouplist:rating -> per-value groups
id_query_ratings_groups = id_query_ratings['vespaResponse']['root']['children'][0]['children'][0]['children']
df = pl.DataFrame({
    "rating": [int(g["value"]) for g in id_query_ratings_groups],
    "count": [g["fields"]["count()"] for g in id_query_ratings_groups],
}).sort("rating")

#print(df)
# navigator_display_dataFrame(DataFrame=df)
navigator_display_chart(DataFrame=df, chartType='doughnutChart', labelField='rating', valueField='count', sampling=True)
#%%vespa
#H1 Sanity check: all max ratings are 2?
POST /search/
{
  "select": {
    "where": {
      "matches": [
        "explanation_attribute",
        "Default max rating is assigned because the query is generated by the document"
      ]
    },
    "grouping": [
      {
        "all": {
          "group": "rating",
          "each": {
            "output": "count()"
          }
        }
      }
    ]
  },
  "hits": 1
}
#%%vespa
#H1 Other reasons?
POST /search/
{
  "select": {
    "where": {
      # exclude all this stuff
      "not": {
        "or": [
          {
            # queries for a specific ID
            "contains": [
              "query",
              {
                "text": {
                  "query": "id:movies:movie",
                  "attributes": {
                    "grammar": "phrase"
                  }
                }
              }
            ]
          },
          {
            # default max ratings
            "matches": [
              "explanation_attribute",
              "Default max rating is assigned because the query is generated by the document"
            ]
          }
        ]
      }
    },
    "grouping": [
      {
        "all": {
          "group": "explanation_attribute",
          "order": "-count()",
          "output": "count()",
          "each": {
            "output": "count()"
          }
        }
      }
    ]
  },
  "model": {
    "restrict": "judgment"
  },
  "hits": 1
}

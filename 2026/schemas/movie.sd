schema movie {
    document movie {
        field movie_id type int {
            indexing: attribute | summary
        }
        field title type string {
            indexing: index | summary
            index: enable-bm25
        }
        field genres type array<string> {
            indexing: attribute | summary
        }
        field year type int {
            indexing: attribute | summary
        }
        field imdb_id type string {
            indexing: attribute | summary
        }
        field tmdb_id type string {
            indexing: attribute | summary
        }
        field overview type string {
            indexing: index | summary
            index: enable-bm25
        }
        field original_language type string {
            indexing: attribute | summary
        }
        field runtime type int {
            indexing: attribute | summary
        }
        field production_countries type array<string> {
            indexing: attribute | summary
        }

        field embedding_fasttext type tensor<float>(x[100]) {
            indexing: attribute | index
            index {
                hnsw {
                    max-links-per-node: 16
                    neighbors-to-explore-at-insert: 100
                }
            }
            attribute {
                distance-metric: angular
            }
        }
    }

    fieldset default {
        fields: title
    }

    rank-profile bm25 {
        first-phase {
            expression: bm25(title)
        }
    }

    rank-profile semantic-fasttext {
        num-threads-per-search: 1
        inputs {
            query(q) tensor<float>(x[100])
        }
        first-phase {
            expression: closeness(field, embedding_fasttext)
        }
    }

    rank-profile hybrid-fasttext {
        num-threads-per-search: 1
        inputs {
            query(q) tensor<float>(x[100])
        }
        first-phase {
            expression: 0.7 * bm25(title) + 0.3 * closeness(field, embedding_fasttext)
        }
    }
}
